# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://freefornonprofits.com
NODE_ENV=production

# Admin Configuration
ADMIN_EMAILS=admin@freefornonprofits.com,support@freefornonprofits.com

# Email Configuration (optional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@freefornonprofits.com
SUPPORT_EMAIL=support@freefornonprofits.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cloudflare Turnstile (optional — signup/submit-tool bot protection)
# Both the honeypot + rate-limiting checks in /api/auth/signup work with
# neither of these set. Set both to also require a Turnstile challenge:
# 1. Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# 2. NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser
# 3. TURNSTILE_SECRET_KEY must stay server-side only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
